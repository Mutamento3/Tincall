# Node 22.5+ with node:sqlite (older versions need --experimental-sqlite;
# Node 24 recommended). Auto selects Supabase when any credential below is set;
# otherwise SQLite. Optional explicit override: sqlite or supabase.
TINCALL_STORAGE=
# SQLite: one persistent file, no Supabase account needed. An empty value uses
# connector/data/tincall.sqlite relative to server.mjs (independent of cwd).
# Relative custom paths are relative to the process working directory.
# Media is streamed to <database-path>.media/; persist and back up both.
TINCALL_SQLITE_PATH=
# Node HTTP defaults; Docker sets HOST=0.0.0.0 inside the container.
# Phone/public access still requires a tunnel or HTTPS reverse proxy.
HOST=127.0.0.1
PORT=8787
# Node OAuth: exact public HTTPS connector base, without /mcp.
# Supabase Edge derives its default gateway URL automatically.
TINCALL_PUBLIC_URL=
# Supabase only: fill ALL THREE values. Partial config fails startup instead
# of silently creating a different SQLite database. Leave blank for SQLite.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TINCALL_WORKER_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SERVER_TOKEN
# JSON arrays on one line. SQLite requires configured bearer clients: owner_id
# is a stable UUID chosen by you; no Supabase Auth user or signup is needed.
# Supabase owner_id must refer to an existing Supabase Auth user.
# Example (replace token): [{"token":"REPLACE_WITH_PRIVATE_RANDOM_PHONE_TOKEN","owner_id":"10000000-0000-4000-8000-000000000001"}]
# Role credentials may also include contact_id. Never put service keys on phones.
TINCALL_CLIENTS=[]
# Set mode=tools only for a deliberately limited MCP polling workflow.
# HTTP mode requires both generation_url and cancel_url on the same HTTPS origin.
TINCALL_BINDINGS=[]
TINCALL_ALLOWED_ORIGINS=[]
# Base HTTPS URL of connector/apns-server.mjs behind your TLS reverse proxy.
TINCALL_PUSH_URL=
TINCALL_PUSH_TOKEN=

# APNs sender process only; these do not belong in the iOS configuration.
TINCALL_APNS_TEAM_ID=
TINCALL_APNS_KEY_ID=
TINCALL_APNS_KEY_FILE=
TINCALL_APNS_TOPIC=com.tincall.app.voip
TINCALL_APNS_DATABASE=connector/.local/apns.sqlite
